    {
      "name": "3 Direct sharing",
      "item": [
        {
          "name": "Share directly with the stranger (download)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/files/{{fileId}}/shares",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
