                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"No link for direct shares\", () => pm.expect(pm.response.json().url).to.eql(null));"
                ]
              }
            }
          ]
        },
        {
          "name": "Stranger – Shared with me",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/shares/received",
              "host": [
                "{{baseUrl}}"
              ],
