          "name": "Public – download refused on a view-only link",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/s/{{viewLink}}/download",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "s",
