                "download"
              ]
            },
            "description": "",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2 Share links",
      "item": [
        {
          "name": "Create link – view only, expires in 1 day",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/files/{{fileId}}/shares",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "files",
                "{{fileId}}",
                "shares"
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{ownerToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"share_type\": \"link\",\n  \"permission\": \"view\",\n  \"expires_at\": \"{{expiresAt}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"expiresAt\", new Date(Date.now() + 24 * 3600 * 1000).toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "const url = pm.response.json().url;",
                  "pm.test(\"Link returned once\", () => pm.expect(url).to.include(\"/s/\"));",
                  "pm.collectionVariables.set(\"viewLink\", url.split(\"/s/\")[1]);",
                  "pm.collectionVariables.set(\"viewLinkId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Public – link details (no account)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/s/{{viewLink}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
