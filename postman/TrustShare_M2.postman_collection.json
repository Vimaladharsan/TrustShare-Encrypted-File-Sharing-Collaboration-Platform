                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const item = pm.response.json().items.find(i => i.file_id === pm.collectionVariables.get(\"fileId\"));",
                  "pm.test(\"File is listed\", () => pm.expect(item).to.be.an(\"object\"));",
                  "pm.collectionVariables.set(\"directShareId\", item.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Stranger – download through the share",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/shares/{{directShareId}}/download",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "shares",
                "{{directShareId}}",
                "download"
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{strangerToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Owner – Shared by me shows every share with status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/shares/sent",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "shares",
                "sent"
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{ownerToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const statuses = pm.response.json().items.map(i => i.status);",
                  "pm.test(\"Revoked and used-up shares are reported\", () => { pm.expect(statuses).to.include(\"revoked\"); pm.expect(statuses).to.include(\"used_up\"); });"
                ]
              }
            }
          ]
        }
      ]
