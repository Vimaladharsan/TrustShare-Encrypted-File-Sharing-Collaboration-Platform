{
  "info": {
    "name": "TrustShare – Milestone 2 (encryption, sharing, access control)",
    "_postman_id": "8f3c2a10-7b1d-4c55-9e1a-2d6f0b9c4e21",
    "description": "End-to-end checks for Milestone 2. Run the whole collection in order (Collection Runner or Newman). It creates two throwaway accounts (@postman.example.com) and one file, then tests encrypted upload/download, access control, share links (view vs download, limit, revoke, expiry), direct sharing, admin RBAC and analytics, and finally deletes the file.\n\nSet baseUrl in the environment (default http://localhost:8000/api). The upload requests use sample-report.pdf and disguised-program.pdf from this folder.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0 Setup",
      "item": [
        {
          "name": "Health check – databases and storage",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const s = pm.response.json().services;",
                  "pm.test(\"All services ok (incl. object storage)\", () => Object.values(s).forEach(v => pm.expect(v).to.eql(\"ok\")));"
                ]
              }
            }
          ]
        },
