    {
      "name": "1 Encrypted upload & download",
      "item": [
        {
          "name": "Upload – encrypted with its own AES-256-GCM key",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/files",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "files"
              ]
            },
            "description": "The backend validates the file, encrypts it with a new key, stores only ciphertext in the private bucket and the wrapped key in PostgreSQL.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{ownerToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "sample-report.pdf"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "const f = pm.response.json();",
                  "pm.collectionVariables.set(\"fileId\", f.id);",
                  "pm.test(\"No storage location or key material in the response\", () => {",
                  "  const text = JSON.stringify(f).toLowerCase();",
                  "  [\"storage_key\", \"wrapped\", \"key_version\", \"encryption\"].forEach(w => pm.expect(text).to.not.include(w));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Upload – disguised program rejected (content check)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/files",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "files"
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{ownerToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "disguised-program.pdf"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 415\", () => pm.response.to.have.status(415));",
                  "pm.test(\"Error code UNSUPPORTED_FILE_TYPE\", () => pm.expect(pm.response.json().error.code).to.eql(\"UNSUPPORTED_FILE_TYPE\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Download – owner gets the decrypted original",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/files/{{fileId}}/download",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "files",
                "{{fileId}}",
                "download"
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{ownerToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Decrypted PDF\", () => pm.expect(pm.response.text()).to.match(/^%PDF-1.4/));",
                  "pm.test(\"Saved as attachment\", () => pm.expect(pm.response.headers.get(\"Content-Disposition\")).to.include(\"attachment\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Download – another user is denied (404, nothing revealed)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/files/{{fileId}}/download",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "files",
                "{{fileId}}",
                "download"
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{strangerToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"Error code FILE_NOT_FOUND\", () => pm.expect(pm.response.json().error.code).to.eql(\"FILE_NOT_FOUND\"));"
                ]
              }
            }
          ]
        },
