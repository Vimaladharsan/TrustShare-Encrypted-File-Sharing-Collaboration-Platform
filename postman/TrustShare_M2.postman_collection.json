              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 403\", () => pm.response.to.have.status(403));",
                  "pm.test(\"Error code SHARE_DOWNLOAD_NOT_ALLOWED\", () => pm.expect(pm.response.json().error.code).to.eql(\"SHARE_DOWNLOAD_NOT_ALLOWED\"));"
                ]
              }
            }
          ]
