         "pm.test(\"Brief fields present\", () => [\"log_id\",\"user_id\",\"username\",\"activity_type\",\"file_id\",\"description\",\"status\",\"ip_address\",\"created_at\",\"hash\"].forEach(f => pm.expect(e).to.have.property(f)));",
