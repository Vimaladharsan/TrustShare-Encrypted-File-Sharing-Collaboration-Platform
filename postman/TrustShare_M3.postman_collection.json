    {
     "name": "Admin – activity feed for the user",
     "request": {
      "method": "GET",
      "header": [],
      "url": {
       "raw": "{{baseUrl}}/activity-monitoring/activities?user_id={{userId}}",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "activity-monitoring",
        "activities"
       ],
       "query": [
        {
         "key": "user_id",
         "value": "{{userId}}"
        }
       ]
      },
      "description": "Task 1: activities are recorded automatically with user, type, file, status, IP and time.",
      "auth": {
       "type": "bearer",
       "bearer": [
        {
         "key": "token",
         "value": "{{adminToken}}",
         "type": "string"
        }
       ]
      }
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
         "const items = pm.response.json().items;",
         "const upload = items.find(i => i.action === \"file.upload\");",
         "pm.test(\"Upload recorded with type, file ID and IP\", () => {",
         "  pm.expect(upload.activity_type).to.eql(\"upload\");",
         "  pm.expect(upload.file_id).to.eql(pm.collectionVariables.get(\"fileId\"));",
         "  pm.expect(upload.ip_address).to.be.a(\"string\");",
         "});",
         "pm.test(\"Download and login recorded\", () => {",
         "  const kinds = items.map(i => i.activity_type);",
         "  pm.expect(kinds).to.include.members([\"download\", \"login\"]);",
         "});",
         "pm.test(\"No file name shown to the admin\", () => pm.expect(pm.response.text()).to.not.include(\"sample-report\"));"
        ]
       }
      }
     ]
    },
    {
