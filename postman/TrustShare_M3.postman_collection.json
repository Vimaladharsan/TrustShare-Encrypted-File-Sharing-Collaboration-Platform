        "raw": {
         "language": "json"
        }
       }
      }
     },
     "event": [
      {
       "listen": "prerequest",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.collectionVariables.set(\"userEmail\", `m3-user-${Date.now()}@postman.example.com`);",
         "pm.collectionVariables.set(\"password\", \"Postman!Pass\" + Math.floor(Math.random() * 1e6) + \"a\");"
        ]
       }
      },
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test(\"Status 202\", () => pm.response.to.have.status(202));"
        ]
       }
      }
