# PRODUCTION settings for the cloud server (used by docker-compose.prod.yml).
# On the server: cp .env.production.example .env, then replace every "change-me" with a NEW random
# value (never reuse your development secrets). Never commit .env. Guide: docs/deployment.md.

# ---------- Public address ----------
# The server's DNS name; Caddy gets a free Let's Encrypt certificate for it.
DOMAIN=trustshare-yourname.centralindia.cloudapp.azure.com
# Let's Encrypt sends certificate notices here.
ACME_EMAIL=you@example.com

POSTGRES_USER=trustshare
POSTGRES_PASSWORD=change-me
POSTGRES_DB=trustshare

MONGO_USER=trustshare
MONGO_PASSWORD=change-me

REDIS_PASSWORD=change-me

# Signs login tokens. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters

# Encrypts MFA secrets at rest. Generate with: python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
MFA_ENCRYPTION_KEY=change-me

# Email (Gmail SMTP). Optional: without these, emails (e.g. password reset links) are printed
# in the backend log instead. SMTP_PASSWORD is a 16-letter Google *app password*, not the
# account password (Google account → Security → 2-Step Verification → App passwords).
SMTP_USER=
SMTP_PASSWORD=
# Where links in emails point to.
FRONTEND_URL=https://trustshare-yourname.centralindia.cloudapp.azure.com
# true = users must click the verification link before they can log in (default: false –
# they can log in and see a reminder).
REQUIRE_EMAIL_VERIFICATION=false

# Google login (optional – the button appears only when both are set). Create an OAuth client
# (type "Web application") in Google Cloud Console; the redirect URI must match exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Add this exact URI to the OAuth client's "Authorized redirect URIs" in Google Cloud Console.
GOOGLE_REDIRECT_URI=https://trustshare-yourname.centralindia.cloudapp.azure.com/api/auth/google/callback

# File encryption master keys (Milestone 2) – versioned, each 32 random bytes in base64.
# Generate one with: python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
# Rotation: add "2:<new key>", set ACTIVE_MASTER_KEY_VERSION=2, run the rotate_keys script, then remove v1.
# To keep existing files readable, use the SAME master keys as the system that encrypted them.
MASTER_KEYS=1:change-me-to-32-random-bytes-in-base64
ACTIVE_MASTER_KEY_VERSION=1

# Object storage for encrypted files: Azure Blob Storage in production (no RustFS on the server).
STORAGE_PROVIDER=azure
# Portal → Storage account → Security + networking → Access keys → Connection string.
AZURE_STORAGE_CONNECTION_STRING=change-me
# A separate container keeps production files apart from development ones (created automatically).
AZURE_CONTAINER=trustshare-files-prod
# Not used with Azure, but must be present.
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=unused
S3_SECRET_ACCESS_KEY=unused-placeholder
S3_BUCKET=trustshare-files
S3_REGION=us-east-1

# ---------- Milestone 3: suspicious-activity detection ----------
# An alert fires when the count goes ABOVE the limit within the window. Lower them for demos.
DETECT_FAILED_LOGINS_LIMIT=5
DETECT_FAILED_LOGINS_MINUTES=10
DETECT_UNAUTHORIZED_LIMIT=4
DETECT_UNAUTHORIZED_MINUTES=10
DETECT_DOWNLOADS_LIMIT=20
DETECT_DOWNLOADS_MINUTES=5
DETECT_EXPIRED_LINK_LIMIT=2
DETECT_EXPIRED_LINK_MINUTES=10
DETECT_REVOKED_LINK_LIMIT=2
DETECT_REVOKED_LINK_MINUTES=10

# ---------- Milestone 3: notifications ----------
SCHEDULER_ENABLED=true            # background job: expiry reminders + expired links
SCHEDULER_INTERVAL_SECONDS=300
LINK_REMINDER_HOURS=24            # remind owners this long before a share expires
DOWNLOAD_NOTICE_COOLDOWN_MINUTES=10
ADMIN_ALERT_EMAIL_COOLDOWN_MINUTES=15
SSE_HEARTBEAT_SECONDS=25
SSE_MAX_SECONDS=3600
