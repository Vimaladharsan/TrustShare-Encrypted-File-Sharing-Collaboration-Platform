# Copy this file to .env and fill in real values. Never commit .env.
POSTGRES_USER=trustshare
POSTGRES_PASSWORD=change-me
POSTGRES_DB=trustshare

MONGO_USER=trustshare
MONGO_PASSWORD=change-me

REDIS_PASSWORD=change-me

# Signs login tokens. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters

# Encrypts MFA secrets at rest. Generate with: python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
MFA_ENCRYPTION_KEY=change-me

# Email (Gmail SMTP). Optional: without these, emails (e.g. password reset links) are printed
# in the backend log instead. SMTP_PASSWORD is a 16-letter Google *app password*, not the
# account password (Google account → Security → 2-Step Verification → App passwords).
SMTP_USER=
SMTP_PASSWORD=
# Where links in emails point to.
FRONTEND_URL=http://localhost:5173
