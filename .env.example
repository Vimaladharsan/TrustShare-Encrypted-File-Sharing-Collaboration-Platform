# Copy this file to .env and fill in real values. Never commit .env.
POSTGRES_USER=trustshare
POSTGRES_PASSWORD=change-me
POSTGRES_DB=trustshare

MONGO_USER=trustshare
MONGO_PASSWORD=change-me

REDIS_PASSWORD=change-me

# Signs login tokens. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters

# Encrypts MFA secrets at rest. Generate with: python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
MFA_ENCRYPTION_KEY=change-me

# Email (Gmail SMTP). Optional: without these, emails (e.g. password reset links) are printed
# in the backend log instead. SMTP_PASSWORD is a 16-letter Google *app password*, not the
# account password (Google account → Security → 2-Step Verification → App passwords).
SMTP_USER=
SMTP_PASSWORD=
# Where links in emails point to.
FRONTEND_URL=http://localhost:5173
# true = users must click the verification link before they can log in (default: false –
# they can log in and see a reminder).
REQUIRE_EMAIL_VERIFICATION=false

# Google login (optional – the button appears only when both are set). Create an OAuth client
# (type "Web application") in Google Cloud Console; the redirect URI must match exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# File encryption master keys (Milestone 2) – versioned, each 32 random bytes in base64.
# Generate one with: python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
# Rotation: add "2:<new key>", set ACTIVE_MASTER_KEY_VERSION=2, run the rotate_keys script, then remove v1.
MASTER_KEYS=1:change-me-to-32-random-bytes-in-base64
ACTIVE_MASTER_KEY_VERSION=1

# Object storage for encrypted files (Milestone 2).
# Local: RustFS (S3-compatible) runs in docker-compose – console http://localhost:9001/rustfs/console/
RUSTFS_ACCESS_KEY=trustshare
RUSTFS_SECRET_KEY=change-me-at-least-8-characters
# How the backend reaches the bucket (local RustFS: same credentials as above).
S3_ENDPOINT_URL=http://rustfs:9000
S3_ACCESS_KEY_ID=trustshare
S3_SECRET_ACCESS_KEY=change-me-at-least-8-characters
S3_BUCKET=trustshare-files
# Real AWS S3 instead: S3_ENDPOINT_URL= (empty), S3_REGION=<your region>, and an IAM user's keys with
# the least-privilege policy in docs/aws-iam-policy.json – see README → "Using real AWS S3".
S3_REGION=us-east-1
# Which storage holds the encrypted files: s3 (RustFS / AWS S3 above) or azure (Azure Blob Storage).
STORAGE_PROVIDER=s3
# Azure: the storage account's connection string (Portal → Storage account → Security + networking →
# Access keys → Connection string) and the private container's name. Keep it out of Git.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_CONTAINER=trustshare-files
