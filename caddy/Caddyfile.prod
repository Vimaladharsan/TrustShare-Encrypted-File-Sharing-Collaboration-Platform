# Production HTTPS entry point for TrustShare.
#
# DOMAIN (e.g. trustshare-vimal.centralindia.cloudapp.azure.com) and ACME_EMAIL come from .env.
# Caddy obtains a free Let's Encrypt certificate for DOMAIN on first start, renews it automatically
# and redirects http:// to https://. For a local test, DOMAIN=localhost uses Caddy's own CA instead.
#
# Routes: /api/* → FastAPI (backend:8000); everything else → the built React app in /srv.

{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	header {
		-Server
		# Browsers must use HTTPS for this site for the next year.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		# Only our own scripts may run. blob: is used for file previews and downloads, data: for
		# QR codes; inline styles come from the chart library.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; frame-src 'self' blob:; connect-src 'self'; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
	}

	handle /api/* {
		reverse_proxy backend:8000
	}

	handle {
		root * /srv
		# Hashed build files never change – cache them for a year; index.html is always revalidated.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
