# Production image for the TrustShare API.
# Differences from the development Dockerfile: only runtime packages (no ruff / pytest), the code is
# copied in (no live mount, no --reload), and the app runs as an unprivileged user.

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DEFAULT_TIMEOUT=120 \
    PIP_RETRIES=10

WORKDIR /app

COPY requirements.txt ./
RUN pip install -r requirements.txt

COPY alembic.ini ./
COPY alembic ./alembic
COPY app ./app

# Never run as root inside the container.
RUN useradd --create-home --uid 10001 trustshare && chown -R trustshare /app
USER trustshare

EXPOSE 8000

# Apply database migrations, then serve with WEB_WORKERS processes (default 2; 1 on a 1 GB machine).
# Everything shared between workers
# (sessions, rate limits, detection windows, the scheduler lock, live events) lives in Redis.
# --proxy-headers: the visitor's IP comes from Caddy's X-Forwarded-For, trusted only from the
# private Docker network.
CMD ["sh", "-c", "alembic upgrade head && exec uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers ${WEB_WORKERS:-2} --proxy-headers --forwarded-allow-ips 172.16.0.0/12 --no-server-header"]
